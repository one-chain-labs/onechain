----- script -----
# Copyright (c) Mysten Labs, Inc.
# SPDX-License-Identifier: Apache-2.0

# fixing issue https://github.com/one-chain-labs/onechain/issues/6546

COIN=$(one client --client.config $CONFIG objects   --json | jq '.[0].data.objectId')
ADDR=$(one client --client.config $CONFIG addresses --json | jq '.addresses[0][1]')

one client --client.config $CONFIG \
  call --package 0x2 --module sui --function transfer --args $COIN $ADDR \
  --gas-budget 100000000 \
  --json | jq '.effects.status'

----- results -----
success: true
exit_code: 0
----- stdout -----
{
  "status": "success"
}

